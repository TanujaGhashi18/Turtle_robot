<?xml version="1.0" ?>
<!--
  surface_final_world.sdf  --  CAPSTONE SURFACE DEMONSTRATION WORLD
  ==========================================================================
  Purpose: a clearly visible, top-side oil-spill survey at the WATER SURFACE
  (z = 0.0), used by launch/surface_mission.launch.py.

  This world is SEPARATE from the underwater acceptance world
  (underwater_world.sdf), which is left completely unchanged.

  SIMPLIFIED SURFACE PHYSICS (documented, not hidden):
  --------------------------------------------------------------------------
  * <gravity> is zero and the Buoyancy plugin is NOT loaded.  A real,
    buoyancy-driven float model made the flat hull tumble in this workspace
    (see urdf/final_robot.urdf comments).  For a reliable, deadline-safe
    demonstration the vehicle instead HOLDS the water plane with its own
    vertical thrusters via the existing depth-hold controller
    (target_depth = 0.0 m).  This is therefore NOT a realistic buoyancy
    model and must be described as a simplified/assisted surface hold.
  * No collisions on the water surface: the surface is a visual cue only.

  Frame convention: +x forward, +y left, +z up, world origin at "home".
  Water surface (waterline) is at z = 0.0.  base_link is spawned at z = 0.0
  so the 0.073 m tall hull straddles the waterline.
-->
<sdf version="1.10">

  <world name="surface_demo">

    <!-- Simplified planar-physics demo: no gravity (see header). -->
    <gravity>0 0 0</gravity>

    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ==== Core systems ==== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Geodetic origin for the NavSat (GPS) sensor. Arbitrary placeholder. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>18.0</latitude_deg>
      <longitude_deg>72.0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
      <intensity>1.4</intensity>
    </light>

    <!-- Bright sky so the pale water and dark oil contrast clearly. -->
    <scene>
      <ambient>0.65 0.68 0.72 1</ambient>
      <background>0.45 0.72 0.92 1</background>
      <grid>false</grid>
    </scene>

    <!-- ==== Water body (visual cue) ====
         A large translucent plane exactly at the waterline z = 0.0.  No
         collision: the vehicle is held at this plane by its depth-hold
         controller (see header). -->
    <model name="water_surface">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <transparency>0.55</transparency>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.10 0.38 0.58 1</ambient>
            <diffuse>0.16 0.58 0.82 1</diffuse>
            <specular>0.35 0.40 0.45 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==== Sea bed (visual depth cue, well below the surface) ==== -->
    <model name="seafloor">
      <static>true</static>
      <pose>0 0 -2.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>30 30 0.4</size></box></geometry>
          <material>
            <ambient>0.10 0.16 0.22 1</ambient>
            <diffuse>0.14 0.22 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- OIL-SPILL PATCHES  (visible dark slicks ON the water surface) -->
    <!-- Placed on the search route so the robot passes each one.      -->
    <!-- ============================================================= -->
    <model name="oil_patch_1">
      <static>true</static>
      <pose>2.0 0.6 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.85</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.10 0.05 0.01 1</ambient>
            <diffuse>0.20 0.10 0.02 1</diffuse>
            <specular>0.25 0.15 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="oil_patch_2">
      <static>true</static>
      <pose>-2.0 2.6 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.85</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.10 0.05 0.01 1</ambient>
            <diffuse>0.20 0.10 0.02 1</diffuse>
            <specular>0.25 0.15 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="oil_patch_3">
      <static>true</static>
      <pose>2.0 -3.4 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.85</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.10 0.05 0.01 1</ambient>
            <diffuse>0.20 0.10 0.02 1</diffuse>
            <specular>0.25 0.15 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==== HOME marker (start / return point) ==== -->
    <model name="home_marker">
      <static>true</static>
      <pose>0 0 0.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.45 0.10 1</ambient>
            <diffuse>0.10 0.75 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tall mast so "home" is obvious from a wide camera view. -->
    <model name="home_mast">
      <static>true</static>
      <pose>0 0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.45 0.10 1</ambient>
            <diffuse>0.10 0.75 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==== Search-area corner poles (mark the survey region) ==== -->
    <model name="corner_markers">
      <static>true</static>
      <link name="c_pp">
        <pose>4 4 0.8 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.04</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.05 1</ambient><diffuse>1.0 0.75 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="c_pn">
        <pose>4 -4 0.8 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.04</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.05 1</ambient><diffuse>1.0 0.75 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="c_np">
        <pose>-4 4 0.8 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.04</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.05 1</ambient><diffuse>1.0 0.75 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="c_nn">
        <pose>-4 -4 0.8 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.04</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.05 1</ambient><diffuse>1.0 0.75 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  <!-- ==== Overview (monitoring) camera: rendered evidence stream ====
         A static camera above the pool used by /tmp/opencode surface frame
         saver to record what the scene actually renders (robot + patches +
         water).  Topic /overview_camera bridged same-name to ROS. -->
    <model name="overview_camera">
      <static>true</static>
      <pose>-8 -6 6 0 0 0</pose>
      <link name="link">
        <pose>0 0 0 0 0.54 0.6435</pose>
        <sensor name="overview_camera" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>overview_camera</topic>
          <camera name="overview_camera">
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
