<?xml version="1.0"?>
<!--
  Bio-inspired turtle robot - simulation model (URDF).
  Preserved from the original project with the following additive changes:
    * Gazebo Harmonic plugins added (4 thrusters, joint-state, odometry).
    * Camera / IMU / NavSat sensors added on new sensor links.
    * body collision hull kept as the (invisible) displacement volume used for buoyancy.
    * internal_equipment mass trimmed so the modelled weight equals the modelled
      displaced water mass (approximately neutral trim). See docs/architecture.md.

  Frame convention:  +x = forward (nose), +y = left, +z = up, base_link at body centre.
-->
<robot name="underwater_turtle_robot">

  <!-- ============================ BODY ============================ -->
  <link name="base_link">

    <visual>
      <origin xyz="-0.167832 -0.122672 -0.0365" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://underwater_robot/meshes/final_body.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="body_green">
        <color rgba="0.05 0.45 0.20 1.0" />
      </material>
    </visual>

    <!--
      Invisible buoyancy / collision volume.
      Volume = 0.25 * 0.15 * 0.0413 = 1.54875e-3 m^3
      Displaced fresh-water mass at 1000 kg/m^3 = 1.54875 kg
      Total modelled dry mass below = 1.549 kg  ->  ~neutral trim.

      The hull is offset so that the centre of buoyancy sits ABOVE and in line
      with the centre of mass (COM ~= (-0.022, 0, +0.009) after URDF fixed-joint
      lumping).  A submerged, neutrally buoyant body is only passively stable
      when the centre of buoyancy is above the centre of mass; placing the hull
      at the origin made the vehicle tumble continuously.
    -->
    <collision name="body_collision">
      <origin xyz="-0.022 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.25 0.15 0.0413" />
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.00503 0.000006 0.01095" rpy="0 0 0" />
      <mass value="0.300" />
      <inertia
        ixx="0.0010550"
        ixy="0.00000135"
        ixz="0.00006672"
        iyy="0.0027364"
        iyz="-0.000000018"
        izz="0.0034476" />
    </inertial>

  </link>

  <!-- ==================== SENSOR LINKS ==================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05" /></geometry>
      <material name="sensor_black"><color rgba="0.05 0.05 0.05 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.010" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="2e-7" ixy="0" ixz="0" iyy="2e-7" iyz="0" izz="2e-7" />
    </inertial>
  </link>

  <link name="gps_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="2e-7" ixy="0" ixz="0" iyy="2e-7" iyz="0" izz="2e-7" />
    </inertial>
  </link>

  <!-- ======== FRONT VERTICAL THRUSTER (heave / pitch) ======== -->
  <link name="front_vertical_thruster">
    <visual>
      <geometry>
        <mesh filename="package://underwater_robot/meshes/thruster_housing.stl"
          scale="1 1 1" />
      </geometry>
      <material name="thruster_blue"><color rgba="0.1 0.3 0.9 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.160" />
      <inertia ixx="0.00010" ixy="0.0" ixz="0.0"
               iyy="0.00010" iyz="0.0" izz="0.00005" />
    </inertial>
  </link>

  <link name="front_vertical_propeller">
    <visual>
      <geometry>
        <mesh filename="package://underwater_robot/meshes/propeller.stl"
          scale="1 1 1" />
      </geometry>
      <material name="propeller_black"><color rgba="0.05 0.05 0.05 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.002" />
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0" izz="0.000001" />
    </inertial>
  </link>

  <joint name="front_vertical_thruster_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_vertical_thruster" />
    <origin xyz="0.062172 0 0.03525" rpy="0 3.14159 1.5708" />
  </joint>

  <joint name="front_vertical_propeller_joint" type="continuous">
    <parent link="front_vertical_thruster" />
    <child link="front_vertical_propeller" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ======== REAR VERTICAL THRUSTER (heave / pitch) ======== -->
  <link name="rear_vertical_thruster">
    <visual>
      <geometry>
        <mesh filename="package://underwater_robot/meshes/thruster_housing.stl"
          scale="1 1 1" />
      </geometry>
      <material name="thruster_blue"><color rgba="0.1 0.3 0.9 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.160" />
      <inertia ixx="0.00010" ixy="0.0" ixz="0.0"
               iyy="0.00010" iyz="0.0" izz="0.00005" />
    </inertial>
  </link>

  <link name="rear_vertical_propeller">
    <visual>
      <geometry>
        <mesh filename="package://underwater_robot/meshes/propeller.stl"
          scale="1 1 1" />
      </geometry>
      <material name="propeller_black"><color rgba="0.05 0.05 0.05 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.002" />
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0" izz="0.000001" />
    </inertial>
  </link>

  <joint name="rear_vertical_thruster_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_vertical_thruster" />
    <origin xyz="-0.205 0 0.03525" rpy="0 3.14159 -1.5708" />
  </joint>

  <joint name="rear_vertical_propeller_joint" type="continuous">
    <parent link="rear_vertical_thruster" />
    <child link="rear_vertical_propeller" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ======== LEFT HORIZONTAL THRUSTER (surge / yaw) ======== -->
  <link name="left_horizontal_thruster">
    <visual>
      <geometry>
        <mesh filename="package://underwater_robot/meshes/thruster_housing.stl"
          scale="1 1 1" />
      </geometry>
      <material name="thruster_blue"><color rgba="0.1 0.3 0.9 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.160" />
      <inertia ixx="0.00010" ixy="0.0" ixz="0.0"
               iyy="0.00010" iyz="0.0" izz="0.00005" />
    </inertial>
  </link>

  <link name="left_horizontal_propeller">
    <visual>
      <geometry>
        <mesh filename="package://underwater_robot/meshes/propeller.stl"
          scale="1 1 1" />
      </geometry>
      <material name="propeller_black"><color rgba="0.05 0.05 0.05 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.002" />
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0" izz="0.000001" />
    </inertial>
  </link>

  <joint name="left_horizontal_thruster_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_horizontal_thruster" />
    <origin xyz="-0.045752 0.1330 0" rpy="3.14159 -1.5708 0" />
  </joint>

  <joint name="left_horizontal_propeller_joint" type="continuous">
    <parent link="left_horizontal_thruster" />
    <child link="left_horizontal_propeller" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ======== RIGHT HORIZONTAL THRUSTER (surge / yaw) ======== -->
  <link name="right_horizontal_thruster">
    <visual>
      <geometry>
        <mesh filename="package://underwater_robot/meshes/thruster_housing.stl"
          scale="1 1 1" />
      </geometry>
      <material name="thruster_blue"><color rgba="0.1 0.3 0.9 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.160" />
      <inertia ixx="0.00010" ixy="0.0" ixz="0.0"
               iyy="0.00010" iyz="0.0" izz="0.00005" />
    </inertial>
  </link>

  <link name="right_horizontal_propeller">
    <visual>
      <geometry>
        <mesh filename="package://underwater_robot/meshes/propeller.stl"
          scale="1 1 1" />
      </geometry>
      <material name="propeller_black"><color rgba="0.05 0.05 0.05 1.0" /></material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.002" />
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
               iyy="0.000001" iyz="0.0" izz="0.000001" />
    </inertial>
  </link>

  <joint name="right_horizontal_thruster_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_horizontal_thruster" />
    <origin xyz="-0.045752 -0.1330 0" rpy="0 1.5708 0" />
  </joint>

  <joint name="right_horizontal_propeller_joint" type="continuous">
    <parent link="right_horizontal_thruster" />
    <child link="right_horizontal_propeller" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- ============ INTERNAL EQUIPMENT (ballast / electronics) ============ -->
  <!--
    mass 0.579 kg = original 0.552 kg + ~0.027 kg trim ballast.
    Total modelled mass = 0.300(base) + 0.579(equipment) + 4*0.160(thrusters)
      + 4*0.002(propellers) + 0.010(camera) + 0.005(imu) + 0.005(gps) = 1.547 kg
    Displaced water mass = 1.54875 kg  ->  slightly POSITIVE trim (+0.00175 kg):
    a stationary, unpowered vehicle rises very slowly (~cm/s) instead of
    settling on the seafloor.  The mission depth-hold keeps it submerged.
  -->
  <link name="internal_equipment">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.579" />
      <inertia ixx="0.0010" ixy="0.0" ixz="0.0"
               iyy="0.0010" iyz="0.0" izz="0.0010" />
    </inertial>
  </link>

  <joint name="internal_equipment_joint" type="fixed">
    <parent link="base_link" />
    <child link="internal_equipment" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ==================== SENSOR MOUNTS ==================== -->
  <!-- Camera: front of the body, pitched ~35 deg down to view the seafloor ahead -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.17 0 -0.02" rpy="0 0.6 0" />
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link" />
    <child link="gps_link" />
    <origin xyz="-0.10 0 0.05" rpy="0 0 0" />
  </joint>

  <!-- ==================== GAZEBO SIMULATION ==================== -->
  <gazebo>
    <self_collide>false</self_collide>
  </gazebo>

  <!--
    Hydrodynamic drag applied with the native Fossen-style
    gz::sim::systems::Hydrodynamics plugin (linear + quadratic drag terms).
    This REPLACES the earlier <velocity_decay> element, whose damping measured
    ~10x weaker than documented (the vehicle reached ~1.2 m/s under a modest
    normalised surge command and rammed the tank wall), and which gave the
    contact solver NaN AABBs during fast corner contact.

    Values (SNAME convention, negative = damping):
      linear  xU/yV/zW  = -2.0 N/(m/s)   -> surge cruise v [m/s] ~= 2 x
                                           normalised surge near rest;
      quadratic xUabsU/yVabsV/zWabsW = -0.8 N/(m/s)^2
                                           -> soft cap: full surge (4 N)
                                           cruises at ~1.2 m/s;
      angular kP/mQ/nR = -0.5 N.m.s/rad  -> gentle turn damping.

    PROVISIONAL simulation tuning, not a validated hydrodynamic model.
    See docs/architecture.md.
  -->
  <gazebo>
    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xU>-2.0</xU>
      <yV>-2.0</yV>
      <zW>-2.0</zW>
      <kP>-0.5</kP>
      <mQ>-0.5</mQ>
      <nR>-0.5</nR>
      <xUabsU>-0.8</xUabsU>
      <yVabsV>-0.8</yVabsV>
      <zWabsW>-0.8</zWabsW>
    </plugin>
  </gazebo>

  <!--
    Thruster plugins (Gazebo Harmonic native gz::sim::systems::Thruster).
    Command = thrust in Newtons (ForceCmd mode, default).
    velocity_control=true  -> propeller joint velocity is written directly
    (no PID tuning required); applied force is still the commanded thrust.
    Limits below are PROVISIONAL simulation limits, not real motor data.
    Command topics (ROS side, see config/bridge.yaml):
      /underwater_robot/thruster/front_vertical/cmd_thrust
      /underwater_robot/thruster/rear_vertical/cmd_thrust
      /underwater_robot/thruster/left_horizontal/cmd_thrust
      /underwater_robot/thruster/right_horizontal/cmd_thrust
  -->
  <gazebo>
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <namespace>underwater_robot</namespace>
      <joint_name>front_vertical_propeller_joint</joint_name>
      <topic>thruster/front_vertical/cmd_thrust</topic>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.053</propeller_diameter>
      <thrust_coefficient>0.005</thrust_coefficient>
      <min_thrust_cmd>-2.0</min_thrust_cmd>
      <max_thrust_cmd>2.0</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <namespace>underwater_robot</namespace>
      <joint_name>rear_vertical_propeller_joint</joint_name>
      <topic>thruster/rear_vertical/cmd_thrust</topic>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.053</propeller_diameter>
      <thrust_coefficient>0.005</thrust_coefficient>
      <min_thrust_cmd>-2.0</min_thrust_cmd>
      <max_thrust_cmd>2.0</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <namespace>underwater_robot</namespace>
      <joint_name>left_horizontal_propeller_joint</joint_name>
      <topic>thruster/left_horizontal/cmd_thrust</topic>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.053</propeller_diameter>
      <thrust_coefficient>0.005</thrust_coefficient>
      <min_thrust_cmd>-2.0</min_thrust_cmd>
      <max_thrust_cmd>2.0</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <namespace>underwater_robot</namespace>
      <joint_name>right_horizontal_propeller_joint</joint_name>
      <topic>thruster/right_horizontal/cmd_thrust</topic>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.053</propeller_diameter>
      <thrust_coefficient>0.005</thrust_coefficient>
      <min_thrust_cmd>-2.0</min_thrust_cmd>
      <max_thrust_cmd>2.0</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>

  <!-- Joint state feedback from the propeller joints -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Odometry (ground-truth pose + twist) for local navigation -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_topic>odometry</odom_topic>
      <tf_topic>tf</tf_topic>
    </plugin>
  </gazebo>

  <!-- Camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera name="camera">
        <horizontal_fov>1.04719755</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- GPS (NavSat) sensor. NOTE: only physically meaningful at the surface.
       The gps_adapter node marks fixes INVALID while submerged. -->
  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <always_on>1</always_on>
      <update_rate>5</update_rate>
      <topic>navsat</topic>
      <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
