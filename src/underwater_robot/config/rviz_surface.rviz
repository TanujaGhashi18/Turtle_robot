Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
    Views:
      - Class: rviz_default_plugins/views/TopDownOrtho
        Name: Top-down
        Target Frame: <Fixed Frame>
        Distance: 16
        X: 0
        Y: 0
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Plane Cell Size: 1
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1
      Show Arrows: true
      Show Axes: true
    - Class: rviz_default_plugins/Odometry
      Name: Robot odometry
      Enabled: true
      Topic:
        Value: /odometry
        Reliability Policy: Reliable
      Keep: 200
      Color: 65;128;243
      Position Tolerance: 0.01
      Angle Tolerance: 0.1
    - Class: rviz_default_plugins/RobotModel
      Name: Turtle robot (URDF)
      Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
      Description Topic:
        Value: /robot_description
        Depth: 5
        Reliability Policy: Reliable
      Visual:
        Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Surface markers
      Enabled: true
      Topic:
        Value: /surface_markers
      Queue Size: 10
    - Class: rviz_default_plugins/Camera
      Name: Robot camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
  Global Options:
    Fixed Frame: odom
    Background Color: 25;32;48
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/FocusCamera
  Window Geometry:
    Width: 1400
    Height: 900